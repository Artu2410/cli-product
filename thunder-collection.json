{
  "info": {
    "_postman_id": "8a4c78dc-2704-4dce-bb8f-2af9d296a931",
    "name": "TechLab API Tests",
    "description": "Pruebas básicas para el proyecto de productos con Firebase y JWT.",
    "schema": "https://www.thunderclient.com/api/v1/collections"
  },
  "item": [
    {
      "name": "Login",
      "request": {
        "url": "http://localhost:3000/api/auth/login",
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"user@email.com\",\n  \"password\": \"strongPass123\"\n}"
        }
      },
      "response": []
    },
    {
      "name": "Get Products",
      "request": {
        "url": "http://localhost:3000/api/products",
        "method": "GET",
        "header": []
      },
      "response": []
    },
    {
      "name": "Get Product by ID",
      "request": {
        "url": "http://localhost:3000/api/products/{{productId}}",
        "method": "GET",
        "header": []
      },
      "response": []
    },
    {
      "name": "Create Product",
      "request": {
        "url": "http://localhost:3000/api/products",
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{jwtToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Mini bosu\",\n  \"description\": \"Producto de rehabilitación ideal para equilibrio y estabilidad.\",\n  \"price\": 35000,\n  \"category\": \"rehabilitación\",\n  \"stock\": 10\n}"
        }
      },
      "response": []
    },
    {
      "name": "Update Product",
      "request": {
        "url": "http://localhost:3000/api/products/{{productId}}",
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{jwtToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"price\": 36000,\n  \"stock\": 12\n}"
        }
      },
      "response": []
    },
    {
      "name": "Delete Product",
      "request": {
        "url": "http://localhost:3000/api/products/{{productId}}",
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwtToken}}"
          }
        ]
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "jwtToken",
      "value": ""
    },
    {
      "key": "productId",
      "value": ""
    }
  ]
}
